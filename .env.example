# Ссылка на ваш проект Supabase (берется из настроек API Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Ключ Service Role Key для обхода политик RLS бэкендом (НЕ ПУБЛИКОВАТЬ в клиентской части!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Секрет для ручного вызова воркера. Используется как /api/process-queue?secret=YOUR_TOKEN
QUEUE_SECRET_TOKEN=local-dev-secret

# Секретный токен для проверки системных вызовов от Vercel Cron.
# Vercel автоматически проставляет его при запросе от Cron. В локальной разработке можно использовать то же значение, что и в QUEUE_SECRET_TOKEN.
CRON_SECRET=local-dev-secret
